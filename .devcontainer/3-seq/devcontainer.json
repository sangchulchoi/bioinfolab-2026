{
  // OWNER 를 본인 GitHub 계정 이름(소문자)으로 바꾼다.
  "name": "3. 서열 분석 (08~09, 12~14)",
  "image": "ghcr.io/OWNER/bioinfolab:seq",

  "remoteEnv": {
    "MYHOME": "${containerWorkspaceFolder}"
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-toolsai.jupyter"],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.autoSave": "afterDelay",
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.renderWhitespace": "boundary"
      }
    }
  },

  "postCreateCommand": "bash .devcontainer/check.sh",

  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  }
}
